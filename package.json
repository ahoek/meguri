{
  "name": "meguri",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "preview:pages": "BASE_PATH=/meguri/ vite build --outDir dist-pages && BASE_PATH=/meguri/ vite preview --outDir dist-pages --port 4174",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "maplibre-gl": "^5.24.0",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "happy-dom": "^20.11.1",
    "sharp": "^0.35.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9",
    "workbox-window": "^7.4.1"
  },
  "allowScripts": {
    "sharp@0.35.3": true
  },
  "packageManager": "pnpm@10.15.0",
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "darwin",
        "linux"
      ],
      "cpu": [
        "arm64",
        "x64"
      ]
    }
  }
}
